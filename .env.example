# Copy this file to .env and put your real keys there.
# .env is NEVER committed and NEVER printed by the agent.
GOOGLE_PLACES_API_KEY=your_google_places_api_key_here

# Supabase (for Slice 2 duplicate check + later submit)
# Use the ANON / publishable key only - NEVER the service_role secret key.
SUPABASE_URL=https://hfwaekjufuovtfgqjsqj.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Meta Model API / Muse Spark (goes in .env.llm, NOT in .env)
# Only used for RARE messy-menu cases (scanned image / awkward PDF menus).
MODEL_API_KEY=your_meta_model_api_key_here
LLM_MODEL=muse-spark-1.3-contributor
LLM_EFFORT=medium
